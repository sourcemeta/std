{
  "target": "../../../../../schemas/2020-12/xbrl/dtr/type/2024-01-31/gyear-list-item-type.json",
  "tests": [
    {
      "description": "Valid - single year",
      "valid": true,
      "data": "2020"
    },
    {
      "description": "Valid - multiple years",
      "valid": true,
      "data": "2020 2021 2022"
    },
    {
      "description": "Valid - negative and long years",
      "valid": true,
      "data": "-1999 1000 12026"
    },
    {
      "description": "Valid - empty list",
      "valid": true,
      "data": ""
    },
    {
      "description": "Valid - surrounding whitespace",
      "valid": true,
      "data": "  2020 2021  "
    },
    {
      "description": "Invalid - timezone designator",
      "valid": false,
      "data": "2024Z"
    },
    {
      "description": "Invalid - three digit year",
      "valid": false,
      "data": "202"
    },
    {
      "description": "Invalid - comma separated",
      "valid": false,
      "data": "2020,2021"
    },
    {
      "description": "Invalid - JSON array of years",
      "valid": false,
      "data": [ "2020", "2021" ]
    },
    {
      "description": "Invalid - number",
      "valid": false,
      "data": 2020
    }
  ]
}
