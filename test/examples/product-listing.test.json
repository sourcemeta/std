      "description": "Valid - complete listing",
      "data": {
        "name": {
          "en": "Wireless Mouse",
          "fr": "Souris sans fil"
        },
        "price": 29.99,
        "priceCurrency": "EUR",
        "weight": 0.085,
        "countryOfOrigin": "DE"
