{
  "target": "../../../../../../schemas/iso/coordinate/2022/latitude/v1.json",
  "tests": [
    {
      "description": "Valid - equator",
      "data": 0,
      "valid": true
    },
    {
      "description": "Valid - north pole",
      "data": 90,
      "valid": true
    },
    {
      "description": "Valid - south pole",
      "data": -90,
      "valid": true
    },
    {
      "description": "Valid - positive decimal",
      "data": 37.7749,
      "valid": true
    },
    {
      "description": "Valid - negative decimal",
      "data": -33.8688,
      "valid": true
    },
    {
      "description": "Invalid - above north pole",
      "data": 90.1,
      "valid": false
    },
    {
      "description": "Invalid - below south pole",
      "data": -90.1,
      "valid": false
    },
    {
      "description": "Invalid - way above range",
      "data": 180,
      "valid": false
    },
    {
      "description": "Invalid - way below range",
      "data": -180,
      "valid": false
    },
    {
      "description": "Invalid type - string",
      "data": "37.7749",
      "valid": false
    },
    {
      "description": "Invalid type - boolean",
      "data": true,
      "valid": false
    },
    {
      "description": "Invalid type - null",
      "data": null,
      "valid": false
    },
    {
      "description": "Invalid type - array",
      "data": [],
      "valid": false
    },
    {
      "description": "Invalid type - object",
      "data": {},
      "valid": false
    },
    {
      "description": "Invalid - just above the maximum",
      "data": 90.0000001,
      "valid": false
    },
    {
      "description": "Valid - exponent notation at the maximum",
      "data": 9e+1,
      "valid": true
    }
  ]
}
