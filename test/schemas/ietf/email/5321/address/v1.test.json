      "data": "\"john..doe\"@example.org",
      "valid": true,
      "rdf": [
        {
          "@id": "mailto:%22john..doe%22@example.org"
        }
      ]
    },
    {
      "description": "Quoted local-part with space",
      "data": "\" \"@example.org",
      "valid": true,
      "rdf": [
        {
          "@id": "mailto:%22%20%22@example.org"
        }
      ]
    },
    {
      "description": "Quoted local-part ending with dot",
      "data": "\"john.doe.\"@example.com",
