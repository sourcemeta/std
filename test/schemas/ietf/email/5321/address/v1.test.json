      "rdf": [
        {
          "@id": "mailto:%22john%40doe%22@example.com"
        }
      ]
    },
    {
      "description": "Example with all allowed special characters in local-part",
      "data": "test!#$%&'*+/=?^_`{|}~@example.com",
