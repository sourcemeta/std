{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RFC 7946 GeoJSON Bounding Box",
  "description": "An array of numbers representing a bounding box that encloses a GeoJSON object, with coordinates in the order: westernmost, southernmost, easternmost, northernmost",
  "$comment": "Boxes beyond three dimensions get one branch per dimension count, since the 2*n length rule and the latitude positions cannot be expressed for unbounded n",
  "examples": [
    [ -180, -90, 180, 90 ],
    [ -122.5, 37.5, -122.0, 38.0 ],
    [ -180, -90, 0, 180, 90, 1000 ]
  ],
  "x-jsonld-container": "@list",
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [ "https://www.rfc-editor.org/rfc/rfc7946#section-5" ],
  "type": "array",
  "anyOf": [
    {
      "description": "2D bounding box",
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "description": "Westernmost longitude",
          "$comment": "RFC 7946 does not constrain longitude range",
          "type": "number"
        },
        {
          "description": "Southernmost latitude",
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Easternmost longitude",
          "$comment": "RFC 7946 does not constrain longitude range",
          "type": "number"
        },
        {
          "description": "Northernmost latitude",
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        }
      ]
    },
    {
      "description": "3D bounding box",
      "maxItems": 6,
      "minItems": 6,
      "prefixItems": [
        {
          "description": "Westernmost longitude",
          "$comment": "RFC 7946 does not constrain longitude range",
          "type": "number"
        },
        {
          "description": "Southernmost latitude",
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Minimum altitude",
          "$ref": "../../../../iso/coordinate/2022/altitude/v1.json"
        },
        {
          "description": "Easternmost longitude",
          "$comment": "RFC 7946 does not constrain longitude range",
          "type": "number"
        },
        {
          "description": "Northernmost latitude",
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Maximum altitude",
          "$ref": "../../../../iso/coordinate/2022/altitude/v1.json"
        }
      ]
    },
    {
      "description": "4D bounding box",
      "maxItems": 8,
      "minItems": 8,
      "prefixItems": [
        {
          "description": "Southwesterly longitude",
          "type": "number"
        },
        {
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Southwesterly value on axis 3",
          "type": "number"
        },
        {
          "description": "Southwesterly value on axis 4",
          "type": "number"
        },
        {
          "description": "Northeasterly longitude",
          "type": "number"
        },
        {
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Northeasterly value on axis 3",
          "type": "number"
        },
        {
          "description": "Northeasterly value on axis 4",
          "type": "number"
        }
      ]
    },
    {
      "description": "5D bounding box",
      "maxItems": 10,
      "minItems": 10,
      "prefixItems": [
        {
          "description": "Southwesterly longitude",
          "type": "number"
        },
        {
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Southwesterly value on axis 3",
          "type": "number"
        },
        {
          "description": "Southwesterly value on axis 4",
          "type": "number"
        },
        {
          "description": "Southwesterly value on axis 5",
          "type": "number"
        },
        {
          "description": "Northeasterly longitude",
          "type": "number"
        },
        {
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Northeasterly value on axis 3",
          "type": "number"
        },
        {
          "description": "Northeasterly value on axis 4",
          "type": "number"
        },
        {
          "description": "Northeasterly value on axis 5",
          "type": "number"
        }
      ]
    },
    {
      "description": "6D bounding box",
      "maxItems": 12,
      "minItems": 12,
      "prefixItems": [
        {
          "description": "Southwesterly longitude",
          "type": "number"
        },
        {
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Southwesterly value on axis 3",
          "type": "number"
        },
        {
          "description": "Southwesterly value on axis 4",
          "type": "number"
        },
        {
          "description": "Southwesterly value on axis 5",
          "type": "number"
        },
        {
          "description": "Southwesterly value on axis 6",
          "type": "number"
        },
        {
          "description": "Northeasterly longitude",
          "type": "number"
        },
        {
          "$ref": "../../../../iso/coordinate/2022/latitude/v1.json"
        },
        {
          "description": "Northeasterly value on axis 3",
          "type": "number"
        },
        {
          "description": "Northeasterly value on axis 4",
          "type": "number"
        },
        {
          "description": "Northeasterly value on axis 5",
          "type": "number"
        },
        {
          "description": "Northeasterly value on axis 6",
          "type": "number"
        }
      ]
    }
  ]
}
