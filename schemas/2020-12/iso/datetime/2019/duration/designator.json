{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISO 8601-1:2019 Duration (Designator Format)",
  "description": "A duration in designator format P[n]Y[n]M[n]DT[n]H[n]M[n]S (§5.5.2.2, §5.5.2.3)",
  "$comment": "ISO 8601 permits omitting any zero-valued component (at least one must remain), allows a decimal fraction on the lowest-order component only, and accepts both comma and full stop as the decimal sign",
  "examples": [
    "P3Y6M4DT12H30M5S",
    "P1Y",
    "PT1H",
    "P1DT1S",
    "P0Y0M0DT0H0M0S",
    "P1.5Y",
    "PT0.5H"
  ],
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [ "https://www.iso.org/standard/70907.html" ],
  "type": "string",
  "anyOf": [
    {
      "pattern": "^P[0-9]+(?:[.,][0-9]+)?Y$"
    },
    {
      "pattern": "^P(?:[0-9]+Y)?[0-9]+(?:[.,][0-9]+)?M$"
    },
    {
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?[0-9]+(?:[.,][0-9]+)?D$"
    },
    {
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+D)?T[0-9]+(?:[.,][0-9]+)?H$"
    },
    {
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+D)?T(?:[0-9]+H)?[0-9]+(?:[.,][0-9]+)?M$"
    },
    {
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+D)?T(?:[0-9]+H)?(?:[0-9]+M)?[0-9]+(?:[.,][0-9]+)?S$"
    }
  ],
  "not": {
    "enum": [ "P", "PT" ]
  }
}
