{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XBRL UTR Voltage Item Type Units (Normative)",
  "description": "Valid units with the recommended status for voltageItemType as defined in the XBRL Units Type Registry",
  "examples": [ "V", "kV", "MV" ],
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [
    "https://www.xbrl.org/specification/utr/rec-2013-11-18/utr-rec-2013-11-18-clean.html",
    "https://www.xbrl.org/utr/utr.xml"
  ],
  "x-registry-date": "2024-10-22",
  "anyOf": [
    {
      "title": "Volt",
      "description": "Electromotive Force",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/volt",
      "x-status": "REC",
      "x-symbol": "V",
      "const": "V"
    },
    {
      "title": "Kilovolt",
      "description": "Thousand Volts of Electromotive Force",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/kilovolt",
      "x-status": "REC",
      "x-symbol": "kV",
      "const": "kV"
    },
    {
      "title": "Megavolt",
      "description": "One million volts",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/megavolt",
      "x-status": "REC",
      "x-symbol": "MV",
      "const": "MV"
    },
    {
      "title": "Gigavolt",
      "description": "One thousand million volts",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/gigavolt",
      "x-status": "REC",
      "x-symbol": "GV",
      "const": "GV"
    }
  ]
}
