{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W3C XML Schema base64Binary",
  "description": "The base64Binary datatype represents Base64-encoded arbitrary binary data (§3.2.16)",
  "$comment": "The XSD grammar requires canonical padding characters and permits a single space after each character",
  "examples": [
    "R0lGODlhAQABAAAAACw=",
    "SGVsbG8gV29ybGQh",
    "YQ==",
    "YWI=",
    "YWJj",
    ""
  ],
  "x-jsonld-datatype": "http://www.w3.org/2001/XMLSchema#base64Binary",
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [ "https://www.w3.org/TR/xmlschema-2/#base64Binary" ],
  "type": "string",
  "pattern": "^((([A-Za-z0-9+/] ?){4})*(([A-Za-z0-9+/] ?){3}[A-Za-z0-9+/]|([A-Za-z0-9+/] ?){2}[AEIMQUYcgkosw048] ?=|[A-Za-z0-9+/] ?[AQgw] ?= ?=))?$",
  "contentEncoding": "base64",
  "contentMediaType": "application/octet-stream"
}
