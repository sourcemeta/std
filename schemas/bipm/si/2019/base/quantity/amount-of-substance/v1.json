  "title": "Amount of substance",
  "description": "Amount of substance is a base quantity measured in moles",
  "examples": [ 0.001, 1, 2, 10, 0.5, 1.5 ],
  "x-jsonld-constants": {
    "http://qudt.org/schema/qudt/hasQuantityKind": {
