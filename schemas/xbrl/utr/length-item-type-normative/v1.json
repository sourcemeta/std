{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XBRL UTR Length Item Type Units (Normative)",
  "description": "Valid units with the recommended status for lengthItemType as defined in the XBRL Units Type Registry",
  "examples": [ "ft", "in", "mi" ],
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [
    "https://www.xbrl.org/specification/utr/rec-2013-11-18/utr-rec-2013-11-18-clean.html",
    "https://www.xbrl.org/utr/utr.xml"
  ],
  "anyOf": [
    {
      "title": "Foot",
      "description": "Twelve Inches",
      "x-jsonld-self": "http://qudt.org/vocab/unit/FT",
      "const": "ft"
    },
    {
      "description": "Inch",
      "x-jsonld-self": "http://qudt.org/vocab/unit/IN",
      "const": "in"
    },
    {
      "title": "Mile",
      "description": "5280 Feet",
      "x-jsonld-self": "http://qudt.org/vocab/unit/MI",
      "const": "mi"
    },
    {
      "title": "Nautical Mile",
      "description": "1.15078 Miles (One Minute of Arc Latitude)",
      "x-jsonld-self": "http://qudt.org/vocab/unit/MI_N",
      "const": "nmi"
    },
    {
      "title": "Yard",
      "description": "Three Feet",
      "x-jsonld-self": "http://qudt.org/vocab/unit/YD",
      "const": "yd"
    },
    {
      "title": "Centimetre",
      "description": "One-hundreth of Metre",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/centimetre",
      "const": "cm"
    },
    {
      "description": "Decimetre",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/decimetre",
      "const": "dm"
    },
    {
      "title": "Kilometre",
      "description": "Thousand Metres",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/kilometre",
      "const": "km"
    },
    {
      "description": "Metre",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/metre",
      "const": "m"
    },
    {
      "title": "Millimetre",
      "description": "One-thousandth of Metre",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/millimetre",
      "const": "mm"
    }
  ]
}
