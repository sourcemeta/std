{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XBRL UTR Pure Item Type Units (Normative)",
  "description": "Valid units with the recommended status for pureItemType as defined in the XBRL Units Type Registry",
  "examples": [ "Monetary_per_Monetary", "pure", "Rate" ],
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [
    "https://www.xbrl.org/specification/utr/rec-2013-11-18/utr-rec-2013-11-18-clean.html",
    "https://www.xbrl.org/utr/utr.xml"
  ],
  "anyOf": [
    {
      "title": "Monetary/Monetary",
      "description": "Exchange Rate Expressed as: Monetary Unit / Monetary Unit",
      "x-status": "REC",
      "const": "Monetary_per_Monetary"
    },
    {
      "title": "pure",
      "description": "Dimensionless (Pure) Number",
      "x-jsonld-self": "http://qudt.org/vocab/unit/UNITLESS",
      "x-status": "REC",
      "const": "pure"
    },
    {
      "description": "Rate",
      "x-status": "REC",
      "const": "Rate"
    }
  ]
}
