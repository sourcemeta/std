{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XBRL UTR Mass Item Type Units",
  "description": "Valid units for massItemType as defined in the XBRL Units Type Registry",
  "examples": [ "lb", "oz", "ozt" ],
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [
    "https://www.xbrl.org/specification/utr/rec-2013-11-18/utr-rec-2013-11-18-clean.html",
    "https://www.xbrl.org/utr/utr.xml"
  ],
  "anyOf": [
    {
      "title": "Pound",
      "description": "Pound of Mass, as Used in Commerce (http://en.wikipedia.org/wiki/Pound_(mass)#Use_in_Commerce))",
      "x-jsonld-self": "http://qudt.org/vocab/unit/LB",
      "const": "lb"
    },
    {
      "title": "Ounce",
      "description": "US Ounce",
      "x-jsonld-self": "http://qudt.org/vocab/unit/OZ",
      "const": "oz"
    },
    {
      "description": "Troy Ounce",
      "x-jsonld-self": "http://qudt.org/vocab/unit/OZ_TROY",
      "const": "ozt"
    },
    {
      "title": "Ton",
      "description": "US Ton",
      "x-jsonld-self": "http://qudt.org/vocab/unit/TON_US",
      "const": "T"
    },
    {
      "title": "Tonne",
      "description": "Tonne (Metric Tonne, Metric Ton)",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/tonne",
      "const": "t"
    },
    {
      "description": "Gram",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/gram",
      "const": "g"
    },
    {
      "description": "Kilogram",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/kilogram",
      "const": "kg"
    },
    {
      "title": "Thousand Tons",
      "description": "One thousand US tons",
      "const": "kT"
    },
    {
      "title": "Million Tons",
      "description": "One million US tons",
      "const": "MT"
    },
    {
      "title": "Billion Tons",
      "description": "One thousand million US tons",
      "const": "GT"
    },
    {
      "title": "Kilotonne",
      "description": "Thousand Tonnes (Metric Tonnes, Metric Tons)",
      "x-jsonld-self": "http://qudt.org/vocab/unit/KiloTON_Metric",
      "const": "kt"
    },
    {
      "title": "Megatonne",
      "description": "Million Tonnes (Metric Tonnes, Metric Tons)",
      "const": "Mt"
    },
    {
      "title": "Gigatonne",
      "description": "Thousand Million Tonnes (Metric Tonnes, Metric Tons)",
      "const": "Gt"
    }
  ]
}
