{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XBRL UTR Area Item Type Units (Normative)",
  "description": "Valid units with the recommended status for areaItemType as defined in the XBRL Units Type Registry",
  "examples": [ "acre", "sqft", "sqmi" ],
  "x-license": "https://github.com/sourcemeta/std/blob/main/LICENSE",
  "x-links": [
    "https://www.xbrl.org/specification/utr/rec-2013-11-18/utr-rec-2013-11-18-clean.html",
    "https://www.xbrl.org/utr/utr.xml"
  ],
  "anyOf": [
    {
      "description": "Acre",
      "x-jsonld-self": "http://qudt.org/vocab/unit/AC",
      "const": "acre"
    },
    {
      "description": "Square Foot",
      "x-jsonld-self": "http://qudt.org/vocab/unit/FT2",
      "const": "sqft"
    },
    {
      "title": "Square Mile",
      "description": "Square Miles",
      "x-jsonld-self": "http://qudt.org/vocab/unit/MI2",
      "const": "sqmi"
    },
    {
      "description": "Square Yard",
      "x-jsonld-self": "http://qudt.org/vocab/unit/YD2",
      "const": "sqyd"
    },
    {
      "description": "Hectare",
      "x-jsonld-self": "https://si-digital-framework.org/SI/units/hectare",
      "const": "ha"
    },
    {
      "title": "Square km",
      "description": "Square Kilometer",
      "x-jsonld-self": "http://qudt.org/vocab/unit/KiloM2",
      "const": "sqkm"
    },
    {
      "title": "Square metre",
      "description": "Square Metre",
      "x-jsonld-self": "http://qudt.org/vocab/unit/M2",
      "const": "sqm"
    }
  ]
}
